[Unit]
Description=Lingxi Archive FastAPI
After=network.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/srv/www/blog/current
EnvironmentFile=/etc/lingxi-blog.env
ExecStart=/srv/www/blog/current/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/www/blog/shared/storage

[Install]
WantedBy=multi-user.target
